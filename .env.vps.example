# Copy to .env.vps on the VPS. Keep the Windows development .env unchanged.
# Use the canonical frontend domain; no trailing slash or path.
FRONTEND_ORIGIN=https://solarsync.marshelportfolio.me
# Backend is accessible only on the VPS loopback interface, behind host Nginx.
VPS_API_PORT=18000
MYSQL_PASSWORD='GANTI_DENGAN_PASSWORD_DATABASE_ACAK_YANG_PANJANG'
MYSQL_ROOT_PASSWORD='GANTI_DENGAN_PASSWORD_ROOT_BERBEDA_YANG_PANJANG'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CACHE_ENABLED=true
SESSION_LIFETIME_SECONDS=28800
SESSION_IDLE_SECONDS=1800
LOGIN_ACCOUNT_LIMIT=10
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_GLOBAL_LIMIT=120
