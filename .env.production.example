# Copy to .env.production, then fill real values. Never replace the local .env.
PUBLIC_DOMAIN=solar.example.com
TLS_CERT_FILE=/absolute/path/to/fullchain.pem
TLS_KEY_FILE=/absolute/path/to/privkey.pem
MYSQL_PASSWORD='GANTI_PASSWORD_APLIKASI'
MYSQL_ROOT_PASSWORD='GANTI_PASSWORD_ROOT'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ENVIRONMENT=production
COOKIE_SECURE=true
CACHE_ENABLED=true
METRICS_ENABLED=false
NEXT_PUBLIC_ENABLE_ROLE_DEMO=false
SESSION_LIFETIME_SECONDS=28800
SESSION_IDLE_SECONDS=1800
LOGIN_ACCOUNT_LIMIT=10
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_GLOBAL_LIMIT=120
