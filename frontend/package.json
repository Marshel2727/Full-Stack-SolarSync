  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
