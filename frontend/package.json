{
  "name": "solarsync-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --quiet",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
