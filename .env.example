# Set to true only for a presentation build that needs the floating role simulator.
NEXT_PUBLIC_ENABLE_ROLE_DEMO=false

# Docker only: use two different strong passwords. Replace before starting.
# Single quotes preserve literal $ characters in Docker Compose .env values.
MYSQL_PASSWORD='GANTI_PASSWORD_APLIKASI'
MYSQL_ROOT_PASSWORD='GANTI_PASSWORD_ROOT'

# Optional profiling flags; cache can be disabled without changing API behavior.
CACHE_ENABLED=true
METRICS_ENABLED=false

# Local development; production settings and HTTPS checklist: AUTH_PRODUCTION.md
APP_ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
SESSION_LIFETIME_SECONDS=28800
SESSION_IDLE_SECONDS=1800
LOGIN_ACCOUNT_LIMIT=10
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_GLOBAL_LIMIT=120

# Google Cloud OAuth client (Web application). Keep the secret on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
