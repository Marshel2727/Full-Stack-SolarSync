APP_NAME=SolarSync API
APP_ENVIRONMENT=development
REDIS_URL=redis://127.0.0.1:6379/0
# Dedicated noeviction Redis, not the evictable cache; Compose supplies its own URL.
# For non-Docker development, provision this separately on a private listener.
AUTH_REDIS_URL=redis://127.0.0.1:6380/0
LOGIN_ACCOUNT_LIMIT=10
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_GLOBAL_LIMIT=120
SESSION_LIFETIME_SECONDS=28800
SESSION_IDLE_SECONDS=1800
CACHE_ENABLED=true
METRICS_ENABLED=false
COOKIE_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solarsync
DB_USER=solarsync_app
DB_PASSWORD=replace_with_your_database_password
# JSON array; use the exact frontend origins you run locally.
CORS_ORIGINS=["http://localhost:3000"]
